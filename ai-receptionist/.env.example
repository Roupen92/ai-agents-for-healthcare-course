# --- Twilio (telephony) ---
# Sign up at twilio.com, grab these from the Console dashboard.
# A free trial account works for testing before you buy a number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- ElevenLabs (voice) ---
ELEVENLABS_API_KEY=
# Default below is ElevenLabs' built-in "Rachel" voice, a calm, professional
# default. Swap for any voice ID from your ElevenLabs account.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- The "brain" (LLM that writes the receptionist's replies) ---
OPENAI_API_KEY=
# If you later want Claude instead, add ANTHROPIC_API_KEY and flip
# BRAIN_PROVIDER to "anthropic" in brain.py — it's a one-function swap.

# --- Server ---
# The public HTTPS URL Twilio can reach. While testing locally this is
# your ngrok URL (e.g. https://abcd1234.ngrok-free.app). In production
# this is wherever you deploy (Railway, Render, etc.).
PUBLIC_BASE_URL=http://localhost:8000
